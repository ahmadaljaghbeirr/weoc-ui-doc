+/* ── Action button hover/active darkening ──────────────────────────────
+   Replaces SweetAlert2's own color-mix()-based hover/active mechanism
+   (see the long comment in the :root block above for why that mechanism
+   was abandoned — it requires an opaque second color and this codebase
+   has none). Mirrors the ONE existing place in this codebase that already
+   does "darken on hover, darker still on active" via an unconditional
+   filter instead of a paint mix: .wui-badge.is-interactive:hover/:active
+   (weoc-labels.css, brightness(0.82)/brightness(0.72)). NOTE: .wui-btn
+   itself does NOT do this — .wui-btn.primary/.danger/.success/.warning/
+   .info:hover only LIGHTEN via brightness(1.03-1.06), and .wui-btn has no
+   :active filter rule at all — so it is not actually the closest existing
+   analog for a hover-darken/active-darker-still shape; the badge pattern
+   is. brightness(0.92) / brightness(0.84) below are chosen to match this
+   file's own prior 8%/16% darken intent exactly (1 - 0.08, 1 - 0.16),
+   just expressed as a filter instead of a color-mix percentage.
+
+   Selectors mirror the vendored rule's target elements exactly (read from
+   CSS/sweetalert2.min.css: `div:where(.swal2-container) button:where(
+   .swal2-styled):where(.swal2-confirm):hover` etc.) but written as plain
+   class selectors instead of :where()-wrapped ones, so they win on
+   specificity alone ((0,3,0) beats the vendor's (0,1,2), since :where()
+   always contributes zero specificity) — no !important needed, consistent
+   with the icon-ring/close-button overrides elsewhere in this file. Each
+   rule also resets `background-color` back to the button's own base color
+   custom property, canceling the vendor's own color-mix() output for that
+   property so the two darkening mechanisms don't stack. */
+.swal2-styled.swal2-confirm:hover {
+  background-color: var(--swal2-confirm-button-background-color);
+  filter: brightness(0.92);
+}
+.swal2-styled.swal2-confirm:active {
+  background-color: var(--swal2-confirm-button-background-color);
+  filter: brightness(0.84);
+}
+.swal2-styled.swal2-deny:hover {
+  background-color: var(--swal2-deny-button-background-color);
+  filter: brightness(0.92);
+}
+.swal2-styled.swal2-deny:active {
+  background-color: var(--swal2-deny-button-background-color);
+  filter: brightness(0.84);
+}
+.swal2-styled.swal2-cancel:hover {
+  background-color: var(--swal2-cancel-button-background-color);
+  filter: brightness(0.92);
+}
+.swal2-styled.swal2-cancel:active {
+  background-color: var(--swal2-cancel-button-background-color);
+  filter: brightness(0.84);
+}
+
