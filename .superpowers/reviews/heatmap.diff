+/* =============================================================================
+   weoc-heatmap.css  —  risk-grid heatmap (WUI.heatmap)
+
+   CSS-grid layout for a configurable rows x cols matrix. Cell background
+   color is set inline per-cell by wui-heatmap.js via --wui-heatmap-cell-color
+   (computed at render time by interpolating the live --color-success /
+   --color-warning / --color-danger tokens — never a hardcoded hex/rgb value,
+   so the whole grid stays correct across every theme without this file
+   needing to know about any of them).
+
+   --wui-heatmap-cols is set inline by the JS factory (same
+   "JS-driven grid sizing via a custom property" convention as .wui-bento's
+   --wui-bento-cols in weoc-grid.css).
+
+   JS engine: JS/wui-heatmap.js.
+   ============================================================================= */
+
+.wui-heatmap {
+  display: grid;
+  grid-template-columns: repeat(var(--wui-heatmap-cols, 1), minmax(0, 1fr));
+  gap: 2px;
+  background: var(--color-border);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-sm);
+  overflow: hidden;
+  font-family: var(--font-body);
+}
+
+.wui-heatmap.has-row-labels {
+  grid-template-columns: auto repeat(var(--wui-heatmap-cols, 1), minmax(0, 1fr));
+}
+
+/* ── Corner + axis labels ─────────────────────────────────────────────────── */
+
+.wui-heatmap-corner {
+  background: var(--color-surface);
+}
+
+.wui-heatmap-col-label,
+.wui-heatmap-row-label {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  background: var(--color-surface);
+  color: var(--color-text-secondary);
+  font-size: var(--text-xs);
+  font-weight: var(--font-semibold);
+  line-height: var(--leading-snug);
+  padding: var(--space-2);
+}
+
+.wui-heatmap-row-label {
+  justify-content: flex-end;
+  text-align: end;
+  padding-inline-end: var(--space-3);
+  white-space: nowrap;
+}
+
+/* ── Cells ─────────────────────────────────────────────────────────────────── */
+
+.wui-heatmap-cell {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  min-height: 3rem;
+  padding: var(--space-2);
+  background: var(--wui-heatmap-cell-color, var(--color-surface));
+  color: var(--color-on-accent);
+  font-size: var(--text-sm);
+  font-weight: var(--font-semibold);
+  line-height: var(--leading-snug);
+  cursor: default;
+  outline: none;
+}
+
+.wui-heatmap-cell.is-empty {
+  background: var(--color-surface);
+  color: var(--color-text-secondary);
+}
+
+/* Focus ring for keyboard users tabbing through cells — same visible-only
+   convention (:focus-visible) used across the rest of the library. */
+.wui-heatmap-cell:focus-visible {
+  box-shadow: inset 0 0 0 2px var(--color-10);
+  z-index: 5;
+}
+
+/* ── Tooltip ───────────────────────────────────────────────────────────────
+   Scoped, CSS-only tooltip local to this component (no dedicated tooltip
+   component exists elsewhere in weoc-ui). Background/text deliberately use
+   --color-text-primary / --color-bg SWAPPED (not a dedicated "inverse"
+   token family, which does not exist in agency-theme.css) — text-primary
+   is already the color guaranteed to read clearly against the page
+   background in every theme, so using it AS the tooltip's background and
+   the page background AS the tooltip's text color produces a real,
+   theme-correct high-contrast inversion with zero new tokens and zero
+   hardcoded hex, verified against agency-theme.css and every theme variant
+   file (agency-theme-{slate,sand,emerald,crimson,daylight,graphite,deep}.css
+   — all define both tokens as a matching near-neutral contrast pair). */
+.wui-heatmap-cell[data-tooltip]:hover::after,
+.wui-heatmap-cell[data-tooltip]:focus-visible::after {
+  content: attr(data-tooltip);
+  position: absolute;
+  bottom: 100%;
+  left: 50%;
+  transform: translateX(-50%);
+  margin-bottom: var(--space-1);
+  background: var(--color-text-primary);
+  color: var(--color-bg);
+  padding: var(--space-2) var(--space-3);
+  border-radius: var(--radius-sm);
+  font-size: var(--text-xs);
+  font-weight: var(--font-regular);
+  white-space: nowrap;
+  pointer-events: none;
+  z-index: 20;
+  box-shadow: var(--shadow-md);
+}
