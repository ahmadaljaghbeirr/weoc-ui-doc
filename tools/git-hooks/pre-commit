#!/bin/sh
# tools/git-hooks/pre-commit
# Regenerates docs/search-index.json whenever a staged change touches
# docs/docs/*.html, docs/index.html (the home page), or docs/i18n/*.js, and
# re-stages the index plus exactly the files the indexer itself reported
# patching with new section ids -- read from its `PATCHED:<path>` stdout
# lines (see tools/build-search-index.js main()), NOT from the originally
# -staged file list. Re-staging the staged-file list instead of the
# indexer's own patched-file list was a real bug (whole-branch review
# Finding 5): the indexer can inject ids into a page that wasn't part of
# the staged change at all, in which case those id-carrying edits would
# ship un-staged while search-index.json (which references those same new
# ids) ships anyway -- a deep link that silently fails to scroll. It also
# reads the WORKING TREE, not the staged content, so blindly `git add`-ing
# a file after running it can sweep in unrelated unstaged edits, silently
# expanding a deliberate partial `git add -p` stage into a full-file stage
# -- see the PRE_UNSTAGED guard below.
#
# Aborts the commit if the indexer finds an unresolved i18n reference --
# see tools/build-search-index.js's own exit-1 path.

set -e

CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/docs/.*\.html$|^docs/index\.html$|^docs/i18n/.*\.js$' || true)

if [ -z "$CHANGED" ]; then
  exit 0
fi

# Snapshot, BEFORE running the indexer, which docs pages already carry
# unstaged (working-tree-vs-index) edits of their own. Taken up front
# because once the indexer has run, its own patch and any pre-existing
# unstaged edit are both just "unstaged changes" in the same file -- there
# is no way to tell them apart after the fact.
PRE_UNSTAGED=$(git diff --name-only -- docs/docs docs/index.html 2>/dev/null || true)

echo "pre-commit: docs/i18n or docs/docs changed, regenerating search index..."

if ! INDEX_OUTPUT=$(node tools/build-search-index.js); then
  echo "$INDEX_OUTPUT"
  echo "pre-commit: aborting commit -- fix the unresolved i18n reference(s) above."
  exit 1
fi

echo "$INDEX_OUTPUT" | grep -v '^PATCHED:' || true

git add docs/search-index.json

PATCHED=$(echo "$INDEX_OUTPUT" | grep '^PATCHED:' | sed 's/^PATCHED://')
CONFLICT=0

if [ -n "$PATCHED" ]; then
  echo "$PATCHED" | while IFS= read -r f; do
    [ -z "$f" ] && continue
    case " $PRE_UNSTAGED " in
      *" $f "*)
        # Pre-existing unstaged edit + the indexer's own id-injection are now
        # indistinguishable in the working tree -- abort rather than guess.
        # Committing search-index.json here regardless would reproduce
        # exactly the bug this hook exists to prevent: an index shipping ids
        # that reference a file whose matching on-disk change never got
        # staged/committed. search-index.json is left staged (harmless --
        # nothing is actually committed on a non-zero hook exit); re-running
        # `git commit` after resolving the file below picks it up again.
        echo "pre-commit: ABORTING -- $f had unstaged changes of its own before the index rebuild." >&2
        echo "pre-commit:   The indexer also patched it with new section id(s), but the two are now" >&2
        echo "pre-commit:   indistinguishable in the working tree, so this hook cannot safely re-stage it." >&2
        echo "pre-commit:   Review 'git diff -- $f', stage what you intend (e.g. 'git add -p $f' or the" >&2
        echo "pre-commit:   whole file), then commit again -- the new section id(s) are already on disk." >&2
        exit 1
        ;;
      *)
        git add "$f"
        ;;
    esac
  done || { CONFLICT=1; }
fi

if [ "$CONFLICT" -eq 1 ]; then
  exit 1
fi

exit 0
